<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="office_world_8desks">
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Simple office environment with walls -->
    <model name="office_room">
      <static>true</static>
      <link name="wall1">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 20 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 20 2.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
      <pose>10 0 0 0 0 0</pose>
    </model>

    <model name="office_room2">
      <static>true</static>
      <link name="wall2">
        <collision name="collision">
